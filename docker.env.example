# AWS S3 Configuration for Docker Compose
# Copy this file to docker.env and fill in your actual AWS credentials
AWS_ACCESS_KEY_ID=your_aws_access_key_id_here
AWS_SECRET_ACCESS_KEY=your_aws_secret_access_key_here

# Note: Create a docker.env file with your actual credentials
# This file should be gitignored to keep your credentials secure
# For production, use proper AWS IAM roles or other secure credential management
